# ── SUPABASE ──────────────────────────────
# Ambil dari: supabase.com → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxx
# service_role key — JANGAN expose ke frontend
SUPABASE_ANON_KEY=eyJxxx

# ── FASTAPI ───────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_random_32_char_string_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ── TELEGRAM ──────────────────────────────
# Ambil dari: @BotFather di Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdef

# ── GEMINI AI ─────────────────────────────
# Ambil dari: aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyXxx
GEMINI_OCR_MODEL=gemini-2.5-flash
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite

# ── REDIS ─────────────────────────────────
# Railway Redis: ambil dari Railway dashboard
REDIS_URL=redis://default:password@host:6379

# ── APP ───────────────────────────────────
APP_ENV=production
# development / production
BACKEND_URL=https://your-backend.railway.app
WEB_URL=https://your-app.vercel.app

# ── WORKER ────────────────────────────────
OCR_WORKER_COUNT=2
OCR_JOB_TIMEOUT=120

# ── RATE LIMITING ─────────────────────────
PHOTO_RATE_LIMIT_PER_USER=10
PHOTO_RATE_LIMIT_WINDOW_SECONDS=60

# ── MBG ───────────────────────────────────
# Semua konstanta MBG dari ENV
# Jangan hardcode di kode
MBG_PRICE_PER_PORTION=15000
MBG_PPH22_RATE=0.015
MBG_PPN_RATE=0.11
MBG_FOOD_ALLOCATION=0.80
MBG_LABOR_ALLOCATION=0.15
MBG_OPS_ALLOCATION=0.05
